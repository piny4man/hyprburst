#!/bin/sh
# Launch burst inside the user's preferred terminal emulator, advertising
# `class=burst` (or `app_id=burst` on Wayland) so the Hyprland rules in the
# README can match and float the window.
#
# Terminal resolution order:
#   1. $TERMINAL if set and on PATH
#   2. alacritty, wezterm, ghostty, kitty, foot (first found wins)

set -eu

pick_terminal() {
    if [ -n "${TERMINAL:-}" ] && command -v "$TERMINAL" >/dev/null 2>&1; then
        printf '%s\n' "$TERMINAL"
        return 0
    fi
    for candidate in alacritty wezterm ghostty kitty foot; do
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

if ! term=$(pick_terminal); then
    echo "burst-launch: no terminal found (set \$TERMINAL or install alacritty/wezterm/ghostty/kitty/foot)" >&2
    exit 1
fi

case "$(basename -- "$term")" in
    foot)
        exec "$term" --app-id=burst burst "$@"
        ;;
    kitty)
        exec "$term" --class=burst burst "$@"
        ;;
    alacritty)
        exec "$term" --class=burst -e burst "$@"
        ;;
    wezterm)
        exec "$term" start --class=burst -- burst "$@"
        ;;
    ghostty)
        exec "$term" --class=burst -e burst "$@"
        ;;
    *)
        exec "$term" -e burst "$@"
        ;;
esac
